{
  "name": "@inthedark/kitsui",
  "version": "0.1.0",
  "description": "UI framework template built around mutable Component wrappers and explicit State transitions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErisInTheDark/kitsui.git"
  },
  "homepage": "https://github.com/ErisInTheDark/kitsui#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/kitsui.umd.js",
  "types": "./dist/kitsui.d.ts",
  "exports": {
    ".": {
      "types": "./dist/kitsui.d.ts",
      "default": "./dist/kitsui.umd.js"
    }
  },
  "unpkg": "dist/kitsui.umd.js",
  "jsdelivr": "dist/kitsui.umd.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "bench": "node --expose-gc --import tsx ./scripts/bench.ts",
    "build": "tsx ./scripts/build.ts",
    "build:dts": "tsx ./scripts/dts.ts",
    "build:docs": "tsx ./scripts/docs.ts",
    "build:package": "tsx ./scripts/publish-package.ts --stage",
    "watch": "tsx ./scripts/watch.ts",
    "test": "vitest",
    "test:run": "tsx ./scripts/arc/run.ts vitest run",
    "typecheck": "tsx ./scripts/typecheck.ts"
  },
  "devDependencies": {
    "@inthedark/wb": "0.0.10",
    "typescript": "6.0.2",
    "typescript-7": "npm:typescript@7.1.0-beta",
    "esbuild": "0.27.3",
    "happy-dom": "20.8.3",
    "vitest": "4.1.2",
    "typedoc": "0.28.18",
    "tsx": "4.21.0",
    "markdown-it": "14.1.1",
    "@types/markdown-it": "14.1.2",
    "@vitest/utils": "4.1.2",
    "chokidar": "5.0.0",
    "ws": "8.20.0",
    "dotenv": "17.3.1",
    "typedoc-plugin-missing-exports": "4.1.3",
    "monaco-editor": "0.55.1"
  }
}